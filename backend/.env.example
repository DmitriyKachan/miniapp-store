# Telegram Bot Server Configuration
PORT=5000

# Telegram Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Public WebApp URL (GitHub Pages or your hosting)
WEBAPP_URL=https://your-username.github.io/miniapp-store/

# Optional: Telegram User IDs of administrators (comma-separated)
ADMIN_IDS=123456789

# Optional: Default Channel or Group Chat ID for order notifications and post broadcasts
ADMIN_CHAT_ID=-100xxxxxxxxxx
